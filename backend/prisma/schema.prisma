generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SECURITY
  PIC
  MANAGEMENT
}

enum VisitType {
  WALK_IN
  PRE_REGISTERED
}

enum VisitStatus {
  WAITING_VALIDATION
  APPROVED
  CHECKED_IN
  CHECKED_OUT
  REJECTED
  CANCELLED
}

enum QrType {
  CHECK_IN
  CHECK_OUT
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  users     User[]
  visits    Visit[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("departments")
}

model User {
  id               String      @id @default(uuid())
  name             String
  username         String?     @unique
  email            String      @unique
  phone            String?
  password         String
  role             Role        @default(PIC)
  departmentId     String?     @map("department_id")
  department       Department? @relation(fields: [departmentId], references: [id])
  isActive         Boolean     @default(true) @map("is_active")
  canReceiveVisits Boolean     @default(true) @map("can_receive_visits")

  visitsAsPic      Visit[]     @relation("VisitPic")
  visitsCheckedIn  Visit[]     @relation("VisitCheckIn")
  visitsCheckedOut Visit[]     @relation("VisitCheckOut")
  featureOverrides UserFeature[]
  passwordResets   PasswordReset[]

  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@index([role])
  @@index([departmentId])
  @@index([phone])
  @@map("users")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  otp       String
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([otp])
  @@map("password_resets")
}

model Visitor {
  id             String   @id @default(uuid())
  fullName       String   @map("full_name")
  phone          String
  company        String?
  identityNumber String?  @map("identity_number")
  identityPhoto  String?  @map("identity_photo") @db.Text
  visits         Visit[]
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@map("visitors")
}

model Visit {
  id               String      @id @default(uuid())
  visitNumber      String      @unique @map("visit_number")
  visitorId        String      @map("visitor_id")
  visitor          Visitor     @relation(fields: [visitorId], references: [id])
  visitType        VisitType   @default(WALK_IN) @map("visit_type")
  status           VisitStatus @default(WAITING_VALIDATION)
  identityPhoto    String?     @map("identity_photo") @db.Text

  departmentId     String      @map("department_id")
  department       Department  @relation(fields: [departmentId], references: [id])
  picUserId        String?     @map("pic_user_id")
  picUser          User?       @relation("VisitPic", fields: [picUserId], references: [id], onDelete: SetNull)
  picNameManual    String?     @map("pic_name_manual")

  purpose          String
  scheduledDate    DateTime    @map("scheduled_date")
  expectedTime     String?     @map("expected_time")
  numberOfVisitors Int         @default(1) @map("number_of_visitors")
  vehiclePlate     String?     @map("vehicle_plate")
  badgeNumber      String?     @map("badge_number")
  note             String?

  checkInAt        DateTime?   @map("check_in_at")
  checkInById      String?     @map("check_in_by_id")
  checkInBy        User?       @relation("VisitCheckIn", fields: [checkInById], references: [id], onDelete: SetNull)
  checkOutAt       DateTime?   @map("check_out_at")
  checkOutById     String?     @map("check_out_by_id")
  checkOutBy       User?       @relation("VisitCheckOut", fields: [checkOutById], references: [id], onDelete: SetNull)
  cancelReason     String?     @map("cancel_reason")

  tokens           QrToken[]
  notifications    NotificationLog[]

  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@index([visitorId])
  @@index([departmentId])
  @@map("visits")
}

model QrToken {
  id        String    @id @default(uuid())
  visitId   String    @map("visit_id")
  visit     Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  token     String    @unique
  type      QrType
  isUsed    Boolean   @default(false) @map("is_used")
  usedAt    DateTime? @map("used_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([visitId])
  @@map("qr_tokens")
}

model NotificationLog {
  id        String   @id @default(uuid())
  visitId   String?  @map("visit_id")
  visit     Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  recipient String
  type      String
  message   String   @db.Text
  status    String   @default("PENDING")
  error     String?
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("notification_logs")
}

model ManagementRecipient {
  id        String   @id @default(uuid())
  name      String
  phone     String
  title     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("management_recipients")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// Pengaturan hak fitur per user. Tidak ada baris = ikut bawaan role.
model UserFeature {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  featureKey String   @map("feature_key")
  enabled    Boolean  @default(true)
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, featureKey])
  @@index([featureKey])
  @@map("user_features")
}
