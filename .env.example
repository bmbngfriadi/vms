# ==============================================================================
# PT CEMINDO GEMILANG TBK – PLANT BATAM
# VISITOR MANAGEMENT SYSTEM (VMS) ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Application Environment
NODE_ENV=production
APP_NAME="PT Cemindo Gemilang Tbk - Plant Batam VMS"
PLANT_LOCATION="Plant Batam"

# Database Configuration (PostgreSQL 15 - Isolated Docker Network)
POSTGRES_USER=vms_prod_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_STRONG_PASSWORD_2026!
POSTGRES_DB=vms_batam
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@vms-postgres:5432/${POSTGRES_DB}?schema=public

# Redis & BullMQ Message Queue
REDIS_HOST=vms-redis
REDIS_PORT=6379

# JWT Authentication & Expiration (Tahap 15)
JWT_SECRET=GENERATE_A_MINIMUM_64_CHARACTER_RANDOM_SECRET_FOR_PRODUCTION
JWT_EXPIRES_IN=24h

# Dedicated WhatsApp Baileys Gateway Service (Tahap 14)
WA_SERVICE_URL=http://vms-whatsapp-service:5001
WA_AUTH_PATH=/app/baileys_auth

# Web Gateway & Nginx Reverse Proxy Ports (Tahap 14)
HTTP_PORT=80
HTTPS_PORT=443

# Production Domain & Subpath Routing Configuration
APP_DOMAIN=vms.cg-plantbatam.com
PUBLIC_PORTAL_URL=https://cg-plantbatam.com/visitor/register

# Rate Limiting & Overstay Threshold
OVERSTAY_DEFAULT_HOURS=8
MAX_DAILY_VISITORS=500
