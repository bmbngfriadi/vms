# ============================================================
# VMS - PT Cemindo Gemilang Tbk, Plant Batam
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# ============================================================

# --- Database ---
POSTGRES_USER=vms_user
POSTGRES_PASSWORD=ganti_dengan_password_kuat
POSTGRES_DB=vms_batam

# --- Keamanan (WAJIB diganti, minimal 24 karakter) ---
JWT_SECRET=ganti_dengan_random_string_panjang_minimal_32_karakter
JWT_EXPIRES_IN=12h

# --- Alamat publik aplikasi (dipakai untuk link pass di WhatsApp & QR Walk-In) ---
# Contoh: https://cg-plantbatam.com/vms
PUBLIC_APP_URL=https://cg-plantbatam.com/vms

# --- Port host internal (untuk di-proxy oleh Nginx server host) ---
# EVCMS menggunakan 5176, maka VMS menggunakan urutan berikutnya: 5177
VMS_PORT=5177
BACKEND_PORT=5001

# --- Seed data awal saat container pertama kali jalan ---
RUN_SEED=true

# --- CORS (kosongkan bila frontend & API satu domain) ---
CORS_ORIGINS=
